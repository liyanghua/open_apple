{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["product_name", "category", "platforms", "duration_seconds", "reference_paths", "source_paths", "copyright_confirmed", "brand_cta", "paid_generation_approved"],
  "properties": {
    "product_name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["douyin", "wechat_channels", "xiaohongshu"]}},
    "duration_seconds": {"type": "integer", "minimum": 10, "maximum": 90},
    "reference_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "copyright_confirmed": {"const": true},
    "brand_cta": {"type": "string", "minLength": 1},
    "narration_required": {"type": "boolean", "default": true},
    "subtitles_required": {"type": "boolean", "default": true},
    "bgm_required": {"type": "boolean", "default": true},
    "budget_usd": {"type": ["number", "null"], "minimum": 0},
    "deadline": {"type": ["string", "null"]},
    "forbidden_claims": {"type": "array", "items": {"type": "string"}},
    "paid_generation_approved": {"type": "boolean"}
  },
  "additionalProperties": false
}
