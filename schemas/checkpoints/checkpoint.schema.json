{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/checkpoints/checkpoint",
  "title": "Pipeline Checkpoint",
  "description": "Full resumable snapshot after each pipeline stage.",
  "type": "object",
  "required": ["version", "project_id", "pipeline_type", "stage", "status", "timestamp", "artifacts"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string" },
    "stage": {
      "type": "string",
      "description": "Stage name — validated at runtime against the pipeline manifest's stage list"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "awaiting_human", "in_progress"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "pipeline_type": { "type": "string", "description": "Pipeline manifest name" },
    "style_playbook": { "type": "string" },
    "checkpoint_policy": { "type": "string", "enum": ["guided", "manual_all", "auto_noncreative"] },
    "human_approval_required": { "type": "boolean" },
    "human_approved": { "type": "boolean" },
    "approval_group": { "type": "string" },
    "approval_bundle_id": { "type": "string" },
    "approval_bundle_version": { "type": "integer", "minimum": 1 },
    "artifacts": {
      "type": "object",
      "description": "Map of artifact name to legacy data/path or verified v2 envelope",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "not": {
              "anyOf": [
                {"required": ["name"]},
                {"required": ["data"]}
              ]
            }
          },
          {
            "type": "object",
            "required": ["name", "path", "semantic_sha256", "artifact_sha256", "data"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "path": {"type": "string", "pattern": "^artifacts/[^/].*"},
              "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "data": {"type": "object"}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "review": {
      "type": "object",
      "description": "Reviewer output for this stage, if any"
    },
    "cost_snapshot": {
      "type": "object",
      "properties": {
        "total_spent_usd": { "type": "number" },
        "total_reserved_usd": { "type": "number" },
        "budget_remaining_usd": { "type": "number" }
      }
    },
    "error": { "type": "string" },
    "next_action": {
      "type": "object",
      "description": "Resume directive written by the agent at in_progress/awaiting_human checkpoints so a resumed session executes directly instead of re-deriving state.",
      "required": ["summary", "verb", "context_refs", "set_at"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "description": "One imperative sentence: what the next agent session must do first." },
        "verb": { "type": "string", "enum": ["run_stage", "await_user", "fix_and_review", "resume_render", "collect_data", "publish", "none"] },
        "priority": { "type": "string", "enum": ["blocking", "normal", "optional"] },
        "context_refs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Relative paths to the artifacts/files the next session must read." },
        "set_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
