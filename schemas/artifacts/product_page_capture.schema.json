{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/product_page_capture",
  "title": "Browser Product Page Capture",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "acquisition_status", "requested_url", "canonical_url", "page_identity", "fact_candidates", "asset_refs", "capture_evidence", "gaps"],
  "properties": {
    "version": {"type": "string", "enum": ["1.0", "1.1"]},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "acquisition_status": {"enum": ["complete", "partial", "awaiting_human", "failed"]},
    "requested_url": {"type": "string", "format": "uri"},
    "canonical_url": {"type": "string", "format": "uri"},
    "page_identity": {
      "type": "object",
      "required": ["platform", "item_id", "url_sku_id", "selected_sku_id", "selected_sku_text", "title"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "url_sku_id": {"type": ["string", "null"]},
        "selected_sku_id": {"type": ["string", "null"]},
        "selected_sku_text": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "store": {"type": "string"},
        "brand": {"type": "string"}
      },
      "additionalProperties": false
    },
    "fact_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "statement", "claim_class", "evidence_status", "sku_scope", "provenance_refs", "allowed_wording", "prohibited_wording", "required_visual_evidence", "risk_level"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "claim_class": {"enum": ["identity", "feature", "advantage", "benefit", "evidence"]},
          "evidence_status": {"enum": ["page_claim", "visually_observed", "needs_human_confirmation", "restricted", "forbidden"]},
          "sku_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_wording": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "prohibited_wording": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_visual_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "risk_level": {"enum": ["low", "medium", "high"]},
          "volatile": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "asset_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capture_evidence": {
      "type": "object",
      "required": ["page_state", "screenshots"],
      "properties": {
        "page_state": {"enum": ["authenticated", "public", "partial"]},
        "dom_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_id", "local_path", "sha256"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1},
              "local_path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "capture_scope": {
      "type": "object",
      "required": ["required_surfaces", "captured_surfaces", "surface_evidence", "fact_candidate_count", "excluded_volatile_count"],
      "properties": {
        "required_surfaces": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["identity", "selected_sku", "parameter_table", "main_gallery", "detail_content"]}
        },
        "captured_surfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["identity", "selected_sku", "parameter_table", "main_gallery", "detail_content"]}
        },
        "surface_evidence": {
          "type": "object",
          "properties": {
            "identity": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "selected_sku": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "parameter_table": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "main_gallery": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "detail_content": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "fact_candidate_count": {"type": "integer", "minimum": 0},
        "excluded_volatile_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "gaps": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{
    "if": {"properties": {"version": {"const": "1.1"}}, "required": ["version"]},
    "then": {"required": ["capture_scope"]}
  }],
  "additionalProperties": false
}
