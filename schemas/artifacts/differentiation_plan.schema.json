{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/differentiation_plan",
  "title": "Differentiation Plan",
  "type": "object",
  "required": ["version", "batch_id", "created_at", "thresholds", "candidate_signatures", "sibling_comparisons", "status"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "batch_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "research_refs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "thresholds": {
      "type": "object", "required": ["action_jaccard", "copy_ngram_dice", "beat_duration_delta"],
      "properties": {
        "action_jaccard": {"type": "number", "minimum": 0, "maximum": 1},
        "copy_ngram_dice": {"type": "number", "minimum": 0, "maximum": 1},
        "beat_duration_delta": {"type": "number", "minimum": 0}
      }, "additionalProperties": false
    },
    "candidate_signatures": {
      "type": "array", "minItems": 1, "items": {"type": "object", "required": ["candidate_id", "product_id", "hook_pattern", "primary_action_keys", "action_keys", "copy_text", "beat_durations", "beat_order", "scene_context", "pacing_curve", "caption_strategy", "audio_strategy", "sibling_similarity_budget"], "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "product_id": {"type": "string", "minLength": 1},
        "hook_pattern": {"type": "string"}, "primary_action_keys": {"type": "array", "items": {"type": "string"}},
        "action_keys": {"type": "array", "items": {"type": "string"}}, "copy_text": {"type": "string"},
        "beat_durations": {"type": "array", "items": {"type": "number", "minimum": 0}}, "beat_order": {"type": "array", "items": {"type": "string"}},
        "scene_context": {"type": "string"}, "pacing_curve": {"type": "string"}, "caption_strategy": {"type": "string"}, "audio_strategy": {"type": "string"},
        "forbidden_repeats": {"type": "array", "items": {"type": "string"}}, "matrix_row_refs": {"type": "array", "items": {"type": "string"}},
        "sibling_similarity_budget": {"type": "number", "minimum": 0, "maximum": 1}
      }, "additionalProperties": false}
    },
    "sibling_comparisons": {"type": "array", "items": {"type": "object", "required": ["candidate_a", "candidate_b", "scope", "status", "action_jaccard", "copy_ngram_dice", "beat_duration_delta", "sibling_similarity_budget"], "properties": {
      "candidate_a": {"type": "string"}, "candidate_b": {"type": "string"}, "product_a": {"type": "string"}, "product_b": {"type": "string"},
      "scope": {"type": "string", "enum": ["same_product", "cross_product"]}, "compared_axes": {"type": "array", "items": {"type": "string"}}, "differing_axes": {"type": "array", "items": {"type": "string"}},
      "action_jaccard": {"type": "number", "minimum": 0, "maximum": 1}, "copy_ngram_dice": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "beat_duration_delta": {"type": ["number", "null"], "minimum": 0},
      "sibling_similarity_budget": {"type": "number", "minimum": 0, "maximum": 1},
      "status": {"type": "string", "enum": ["high_similarity", "distinct", "needs_redesign"]}
    }, "additionalProperties": false}},
    "status": {"type": "string", "enum": ["pass", "needs_redesign"]},
    "semantic_sha256": {"type": "string"}, "artifact_sha256": {"type": "string"}
  },
  "additionalProperties": false
}
