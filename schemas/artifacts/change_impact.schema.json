{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/change_impact",
  "title": "Change Impact",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "previous_lock_hash", "current_lock_hash", "route", "reasons", "dirty_scene_ids", "reopen_creative_lock", "reopen_sample"],
  "properties": {
    "version": {"type": "string"}, "project_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous_lock_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "current_lock_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "route": {"type": "string", "enum": ["no_render", "mux_only", "full_render"]}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dirty_scene_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "reopen_creative_lock": {"type": "boolean"}, "reopen_sample": {"type": "boolean"}
  },
  "additionalProperties": false
}
