{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opening_experiment",
  "type": "object",
  "required": [
    "version",
    "experiment_id",
    "sku",
    "window_seconds",
    "master_ref",
    "baseline_ref",
    "facts_ref",
    "brand_ref",
    "frozen_body_ref",
    "budget_ref",
    "candidates"
  ],
  "properties": {
    "version": {
      "const": "2.0"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sku": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "window_seconds": {
      "const": [
        0,
        3
      ]
    },
    "master_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "sku"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "baseline_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "sku"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "facts_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "sku"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "brand_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "frozen_body_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "budget_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "hook_plan_ref"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "hook_plan_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "version"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "version": {
                "const": "2.0"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "motion_requirement": {
      "enum": [
        "subject_motion_required",
        "optional"
      ]
    }
  },
  "additionalProperties": false
}
