{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/sample_report",
  "title": "Sample Render Report",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "final_props_hash", "render_plan_hash", "window", "output_path", "probe", "qa", "status"],
  "properties": {
    "version": {"type": "string"}, "project_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "final_props_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "render_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "window": {"type": "object", "required": ["startFrame", "endFrameExclusive", "scale"], "additionalProperties": false, "properties": {"startFrame": {"type": "integer", "minimum": 0}, "endFrameExclusive": {"type": "integer", "minimum": 1}, "scale": {"type": "number", "const": 0.5}}},
    "output_path": {"type": "string", "minLength": 1},
    "probe": {"type": "object", "required": ["width", "height", "fps", "frame_count"], "additionalProperties": true, "properties": {"width": {"type": "integer", "const": 540}, "height": {"type": "integer", "const": 960}, "fps": {"type": "number", "const": 30}, "frame_count": {"type": "integer", "minimum": 1}}},
    "qa": {"type": "object", "additionalProperties": true}, "cache_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"type": "string", "enum": ["pass", "revise", "fail"]}
  },
  "additionalProperties": false
}
