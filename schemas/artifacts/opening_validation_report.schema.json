{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opening_validation_report",
  "type": "object",
  "required": [
    "version",
    "scope",
    "render",
    "dependencies",
    "checks"
  ],
  "properties": {
    "version": {
      "const": "2.0"
    },
    "scope": {
      "enum": [
        "preview",
        "full_variant"
      ]
    },
    "render": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "shot_id",
          "status",
          "method",
          "evidence_interval_seconds",
          "reviewer"
        ],
        "properties": {
          "id": {
            "enum": [
              "opening_motion",
              "opening_framing"
            ]
          },
          "shot_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "error"
            ]
          },
          "method": {
            "enum": [
              "independent_semantic_review",
              "human_review",
              "optical_flow",
              "agent_observation",
              "unmeasured"
            ]
          },
          "evidence_interval_seconds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "reviewer": {
            "type": "object",
            "required": [
              "kind",
              "id",
              "reviewed_at"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "human",
                  "semantic_verifier",
                  "agent"
                ]
              },
              "id": {
                "type": "string"
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "observation_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "issues": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
