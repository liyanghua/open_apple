{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/shot_execution_plan",
  "title": "Shot Execution Plan",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "plan_id",
    "plan_version",
    "status",
    "created_at",
    "creative_control_ref",
    "script_ref",
    "scene_plan_ref",
    "shots"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "needs_revision",
        "approved"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "creative_control_ref": {
      "$ref": "#/$defs/artifact_ref"
    },
    "script_ref": {
      "$ref": "#/$defs/artifact_ref"
    },
    "scene_plan_ref": {
      "$ref": "#/$defs/artifact_ref"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "semantic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approval"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": [
        "artifact",
        "version",
        "artifact_sha256"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "source_selection": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "media_id",
            "path",
            "start_seconds",
            "end_seconds",
            "fit_reason"
          ],
          "properties": {
            "media_id": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "pattern": "^inputs/source/"
            },
            "start_seconds": {
              "type": "number",
              "minimum": 0
            },
            "end_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fit_reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "generation_proposal": {
      "type": "object",
      "required": [
        "id",
        "operation",
        "prompt",
        "duration_seconds",
        "aspect_ratio",
        "reference_paths",
        "consistency_requirements",
        "prohibitions",
        "estimated_fast_cost_usd",
        "estimated_standard_cost_usd",
        "evidence_risk"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "text_to_video",
            "image_to_video",
            "reference_to_video"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "model_family": {
          "type": "string",
          "minLength": 1
        },
        "provider_capability": {
          "const": "video_generation"
        },
        "provider_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/provider_candidate"}
        },
        "selected_provider_candidate": {"$ref": "#/$defs/provider_candidate"},
        "provider_selection_status": {
          "enum": ["awaiting_human", "locked"]
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 4,
          "maximum": 15
        },
        "aspect_ratio": {
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "3:4"
          ]
        },
        "reference_paths": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reference_asset_id": {"type": "string", "minLength": 1},
        "reference_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "required_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_results": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "consistency_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimated_fast_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "estimated_standard_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "retry_limit": {"type": "integer", "minimum": 0, "maximum": 3},
        "approval_subject_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_role": {"const": "visual_expression_only"},
        "evidence_risk": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "provider_candidate": {
      "type": "object",
      "required": ["tool", "provider", "model", "estimated_cost_usd", "supports_local_reference", "supports_native_3_4"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "supports_local_reference": {"const": true},
        "supports_native_3_4": {"const": true}
      },
      "additionalProperties": false
    },
    "generation_reference": {
      "type": "object",
      "required": ["asset_id", "parent_asset_id", "local_path", "sha256", "sku_scope"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "parent_asset_id": {"type": "string", "minLength": 1},
        "local_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sku_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "required": [
        "id",
        "order",
        "purpose",
        "duration_seconds",
        "narration",
        "screen_copy",
        "subject_action",
        "setting",
        "framing",
        "camera",
        "lighting",
        "sound",
        "evidence_type",
        "coverage_status",
        "gap_class",
        "gap_strategy",
        "source_selection",
        "reference_mechanisms",
        "industry_notes",
        "control_rule_refs",
        "generation_proposals",
        "selected_generation_task_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "narration": {
          "type": "string"
        },
        "screen_copy": {
          "type": "string"
        },
        "subject_action": {
          "type": "string"
        },
        "setting": {
          "type": "string"
        },
        "framing": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "sound": {
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "real_proof",
            "demonstration",
            "atmosphere",
            "transition",
            "cta"
          ]
        },
        "coverage_status": {
          "enum": [
            "enough",
            "gap"
          ]
        },
        "gap_class": {
          "enum": [
            "none",
            "expressive",
            "evidential"
          ]
        },
        "gap_strategy": {
          "enum": [
            "none",
            "real_capture",
            "rephrase",
            "remove",
            "generate",
            "generate_from_product_image"
          ]
        },
        "source_selection": {
          "$ref": "#/$defs/source_selection"
        },
        "reference_mechanisms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industry_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "control_rule_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generation_proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generation_proposal"
          }
        },
        "selected_generation_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scene_id": {
          "type": "string",
          "description": "键控配对字段：本 shot 对应 scene/slot（评审 P0-1，禁止位置推断）"
        },
        "section_id": {
          "type": "string",
          "description": "键控配对字段：本 shot 对应 script section"
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "action_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_row_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "product_fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^product_facts\\.claims\\[[0-9]+\\]$"}},
        "product_page_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^product_page_capture\\.fact_candidates\\[[0-9]+\\]$"}},
        "page_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "page_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "visual_route": {"enum": ["owned_source", "generated_from_product_image"]},
        "claim_visual_requirements": {"type": "object", "additionalProperties": true},
        "generation_reference": {"oneOf": [{"$ref": "#/$defs/generation_reference"}, {"type": "null"}]},
        "evidence_role": {"enum": ["owned_visual_evidence", "visual_expression_only"]},
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_interval": {
          "type": "object",
          "required": ["start_seconds", "end_seconds_exclusive"],
          "properties": {
            "start_seconds": {"type": "number", "minimum": 0},
            "end_seconds_exclusive": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        },
        "narration_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "screen_copy_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tts_asset_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "tts_measured_duration": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "caption_timeline_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "template_slot_ref": {
          "type": "string",
          "description": "键控配对字段：本 shot 对应 scene/slot（评审 P0-1，禁止位置推断）"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"visual_route": {"const": "generated_from_product_image"}}, "required": ["visual_route"]},
          "then": {
            "not": {"anyOf": [{"required": ["source_hash"]}, {"required": ["source_interval"]}]},
            "properties": {
              "coverage_status": {"const": "gap"},
              "gap_class": {"const": "expressive"},
              "gap_strategy": {"const": "generate_from_product_image"},
              "source_selection": {"type": "null"},
              "evidence_type": {"not": {"const": "real_proof"}},
              "generation_proposals": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/generation_proposal"},
                    {"required": ["provider_capability", "provider_candidates", "selected_provider_candidate", "provider_selection_status", "reference_asset_id", "reference_hash", "required_actions", "required_results", "retry_limit", "approval_subject_hash", "evidence_role"]}
                  ]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
