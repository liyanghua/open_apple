{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/campaign_content_links",
  "title": "Campaign Content Link Index",
  "description": "All immutable slot-to-version links for one campaign wave.",
  "type": "object",
  "required": ["version", "campaign_id", "links"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "links": {"type": "array", "items": {"type": "object"}},
    "semantic_sha256": {"type": "string"},
    "artifact_sha256": {"type": "string"}
  },
  "additionalProperties": false
}
