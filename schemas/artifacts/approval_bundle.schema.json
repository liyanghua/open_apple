{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/approval_bundle",
  "title": "Approval Bundle",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "bundle_id", "bundle_version", "group", "terminal_stage", "members", "artifact_refs", "status"],
  "properties": {
    "version": {"type": "string"}, "project_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundle_id": {"type": "string", "minLength": 1}, "bundle_version": {"type": "integer", "minimum": 1}, "group": {"type": "string", "minLength": 1}, "terminal_stage": {"type": "string", "minLength": 1},
    "members": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifact_refs": {"type": "array", "items": {"type": "object", "required": ["name", "path", "semantic_sha256", "artifact_sha256"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^artifacts/[^/].*"}, "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "status": {"type": "string", "enum": ["awaiting_human", "approved", "rejected", "superseded"]}, "approved_by": {"type": "string"}, "rejected_reason": {"type": "string"}, "superseded_by": {"type": "string"}
  },
  "additionalProperties": false
}
