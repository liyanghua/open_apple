{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/brand_profile",
  "title": "Brand Profile",
  "description": "Optional user-approved defaults that may fill, but never silently override, production choices.",
  "type": "object",
  "required": ["version", "profile_id"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "voice": {
      "type": "object",
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "minLength": 1},
        "voice": {"type": "string", "minLength": 1},
        "rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 4}
      },
      "additionalProperties": false
    },
    "bgm": {
      "type": "object",
      "properties": {"family": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "font": {
      "type": "object",
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "fallbacks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "files": {"type": "array", "items": {"$ref": "#/$defs/fontFile"}}
      },
      "additionalProperties": false
    },
    "caption_profile": {
      "type": "object",
      "properties": {
        "safe_zone_profile": {"type": "string", "enum": ["douyin_9_16", "wechat_9_16", "xiaohongshu_9_16"]},
        "font_min": {"type": "integer", "minimum": 1},
        "font_max": {"type": "integer", "minimum": 1},
        "max_width": {"type": "integer", "minimum": 1, "maximum": 864},
        "strip_trailing_punctuation": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "emphasis_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "color", "effect"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "color": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "enum": ["scale", "underline", "color"]}
        },
        "additionalProperties": false
      }
    },
    "cta_pattern": {"type": "string", "minLength": 1},
    "production": {"$ref": "#/$defs/production"},
    "platform_defaults": {
      "type": "object",
      "propertyNames": {"enum": ["douyin", "wechat", "xiaohongshu"]},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "aspect_ratio": {"type": "string", "enum": ["9:16", "1:1", "16:9"]},
          "resolution": {"type": "string", "pattern": "^[0-9]+x[0-9]+$"},
          "fps": {"type": "integer", "minimum": 1, "maximum": 120}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fontFile": {
      "type": "object",
      "required": ["path", "src", "sha256", "weight"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "src": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "weight": {"type": "integer", "enum": [400, 700]}
      },
      "additionalProperties": false
    },
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "coordinate": {"type": "number"},
    "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/positive"}},
    "production": {
      "type": "object",
      "required": ["font_mode", "legacy_font_stack", "logo", "title", "underline", "caption", "transition", "slogan", "min_tail_seconds", "recipe"],
      "properties": {
        "font_mode": {"enum": ["strict", "legacy_appearance"]},
        "legacy_font_stack": {"type": "string", "minLength": 1},
        "logo": {
          "type": "object", "required": ["right", "top", "width", "clear_space"],
          "properties": {
            "right": {"$ref": "#/$defs/coordinate"}, "top": {"$ref": "#/$defs/coordinate"},
            "width": {"$ref": "#/$defs/positive"}, "clear_space": {"type": "number", "minimum": 0}
          }, "additionalProperties": false
        },
        "title": {
          "type": "object", "required": ["left", "top", "font_size", "font_weight", "line_height", "characters"],
          "properties": {
            "left": {"$ref": "#/$defs/coordinate"}, "top": {"$ref": "#/$defs/coordinate"},
            "font_size": {"type": "integer", "minimum": 1}, "font_weight": {"const": 700},
            "line_height": {"$ref": "#/$defs/positive"}, "characters": {"$ref": "#/$defs/range"}
          }, "additionalProperties": false
        },
        "underline": {
          "type": "object", "required": ["height", "gap", "color", "width"],
          "properties": {
            "height": {"$ref": "#/$defs/positive"}, "gap": {"type": "number", "minimum": 0},
            "color": {"type": "string", "pattern": "^#[a-fA-F0-9]{6}$"}, "width": {"const": "title"}
          }, "additionalProperties": false
        },
        "caption": {
          "type": "object", "required": ["left", "right", "top", "font_size", "font_weight", "line_height"],
          "properties": {
            "left": {"$ref": "#/$defs/coordinate"}, "right": {"$ref": "#/$defs/coordinate"},
            "top": {"$ref": "#/$defs/coordinate"}, "font_size": {"type": "integer", "minimum": 1},
            "font_weight": {"const": 400}, "line_height": {"$ref": "#/$defs/positive"}
          }, "additionalProperties": false
        },
        "transition": {
          "type": "object", "required": ["frames", "rule"],
          "properties": {"frames": {"const": 5}, "rule": {"const": "incoming_only"}},
          "additionalProperties": false
        },
        "slogan": {"type": "string", "minLength": 1},
        "min_tail_seconds": {"type": "number", "minimum": 0.4},
        "recipe": {
          "type": "object", "required": ["id", "raw_action_seconds", "body_cut_seconds"],
          "properties": {
            "id": {"type": "string", "minLength": 1}, "default_raw_seconds": {"$ref": "#/$defs/positive"},
            "raw_action_seconds": {"$ref": "#/$defs/range"}, "body_cut_seconds": {"$ref": "#/$defs/range"}
          }, "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
