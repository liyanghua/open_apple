{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/motion_generation_task",
  "title": "Motion Generation Task",
  "description": "Seedance等动作生成任务的可重试、可审计记录。",
  "type": "object",
  "required": ["version", "task_id", "content_version_id", "asset_slot_id", "reference_asset_id", "fact_snapshot_id", "prompt_version", "provider", "model", "duration_seconds", "width", "height", "aspect_ratio", "status", "attempts"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "content_version_id": {"type": "string", "minLength": 1},
    "asset_slot_id": {"type": "string", "minLength": 1},
    "reference_asset_id": {"type": "string", "minLength": 1},
    "fact_snapshot_id": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 3, "maximum": 5},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "aspect_ratio": {"type": "string", "minLength": 1},
    "provider_job_id": {"type": ["string", "null"]},
    "cost_reservation_id": {"type": ["string", "null"]},
    "failure_class": {"type": ["string", "null"], "enum": [null, "input_ratio", "privacy_block", "identity_drift", "composition_failure", "incomplete_action", "texture_color_drift", "provider_error"]},
    "identity_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "action_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "pool_status": {"type": "string", "enum": ["not_admitted", "candidate", "approved", "rejected"]},
    "status": {"type": "string", "enum": ["planned", "queued", "running", "reconcile_required", "succeeded", "failed", "cancelled"]},
    "attempts": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "semantic_sha256": {"type": "string"},
    "artifact_sha256": {"type": "string"}
  },
  "additionalProperties": false
}
