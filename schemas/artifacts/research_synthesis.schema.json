{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/research_synthesis",
  "title": "Research Synthesis",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "summary", "differentiation_directions", "industry_prior_evaluations", "conflicts"],
  "properties": {
    "version": {"type": "string"}, "project_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary": {"type": "string"}, "differentiation_directions": {"type": "array", "items": {"$ref": "#/$defs/direction"}}, "industry_prior_evaluations": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "conflicts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "reference_critique": {"$ref": "#/$defs/reference_critique"}
  },
  "$defs": {
    "direction": {"type": "object", "required": ["direction_id", "title", "promise", "keep_from_reference", "change_for_project", "avoid", "industry_prior_refs", "matrix_row_refs", "prerequisites", "tradeoffs"], "properties": {"direction_id": {"type": "string"}, "title": {"type": "string"}, "promise": {"type": "string"}, "keep_from_reference": {"type": "array", "items": {"type": "string"}}, "change_for_project": {"type": "array", "items": {"type": "string"}}, "avoid": {"type": "array", "items": {"type": "string"}}, "industry_prior_refs": {"type": "array", "items": {"type": "string"}}, "matrix_row_refs": {"type": "array", "items": {"type": "string"}}, "prerequisites": {"type": "array", "items": {"type": "string"}}, "tradeoffs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "reference_critique": {"type": "object", "required": ["reference_ceiling"], "properties": {"reference_ceiling": {"type": "string", "enum": ["high", "medium", "low"], "description": "参考片的质量天花板：high=可直接对标 / medium=需局部升级 / low=仅借结构"}, "keep": {"type": "array", "items": {"type": "string"}, "description": "值得保留的机制/结构"}, "improve": {"type": "array", "items": {"type": "string"}, "description": "需要改进的薄弱点"}, "replace": {"type": "array", "items": {"type": "string"}, "description": "需要替换的做法"}, "do_not_copy": {"type": "array", "items": {"type": "string"}, "description": "绝不照抄的元素（品牌/水印/身份/逐镜表达）"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
