{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/product_asset_ledger",
  "title": "Product Page Asset Ledger",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "assets"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "source_page_ref", "asset_role", "usage_role", "original_url", "local_path", "width", "height", "mime_type", "sha256", "sku_scope", "parent_asset_id", "transforms"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "source_page_ref": {"type": "string", "minLength": 1},
          "asset_role": {"enum": ["main_gallery", "selected_sku", "sku_option", "detail", "qualification", "review", "derived_clean_reference"]},
          "usage_role": {"enum": ["identity_anchor", "composition_reference", "information_evidence", "analysis_only", "forbidden", "generation_reference"]},
          "original_url": {"type": "string", "format": "uri"},
          "local_path": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "mime_type": {"type": "string", "pattern": "^image/"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sku_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "parent_asset_id": {"type": ["string", "null"]},
          "claim_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^product_facts\\.claims\\[[0-9]+\\]$"}},
          "derived_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "transforms": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {"$ref": "#/$defs/transform"}
              ]
            }
          },
          "clean_reference_status": {"enum": ["ready", "needs_human", "rejected"]},
          "ocr_regions": {"type": "array", "items": {"$ref": "#/$defs/ocr_region"}},
          "ocr_residual_text": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "identity_check": {"$ref": "#/$defs/identity_check"},
          "generation_eligibility": {"enum": ["eligible", "needs_human", "rejected"]}
        },
        "allOf": [
          {
            "if": {"properties": {"asset_role": {"const": "derived_clean_reference"}}, "required": ["asset_role"]},
            "then": {
              "required": ["claim_refs", "derived_asset_ids", "clean_reference_status", "ocr_regions", "ocr_residual_text", "identity_check", "generation_eligibility"],
              "properties": {
                "usage_role": {"const": "generation_reference"},
                "parent_asset_id": {"type": "string", "minLength": 1},
                "transforms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transform"}}
              }
            }
          },
          {
            "if": {"properties": {"clean_reference_status": {"const": "ready"}}, "required": ["clean_reference_status"]},
            "then": {
              "properties": {
                "ocr_residual_text": {"maxItems": 0},
                "identity_check": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
                "generation_eligibility": {"const": "eligible"}
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "transform": {
      "type": "object",
      "required": ["operation", "input_hash", "output_hash"],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "parameters": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "ocr_region": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "bounds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "identity_check": {
      "type": "object",
      "required": ["status", "notes"],
      "properties": {
        "status": {"enum": ["pass", "needs_human", "rejected"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
