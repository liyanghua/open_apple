{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmontage.local/schemas/artifacts/final_props.schema.json",
  "title": "Final render properties",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "compositionId", "fps", "width", "height", "durationInFrames", "footage", "scenes", "captions", "audio"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "compositionId": {"type": "string", "minLength": 1},
    "fps": {"type": "integer", "const": 30},
    "width": {"type": "integer", "exclusiveMinimum": 0},
    "height": {"type": "integer", "exclusiveMinimum": 0},
    "durationInFrames": {"type": "integer", "exclusiveMinimum": 0},
    "footage": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "captions": {"type": "array", "items": {"type": "object", "required": ["text", "startMs", "endMs"], "properties": {"text": {"type": "string"}, "startMs": {"type": "number", "minimum": 0}, "endMs": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": true}},
    "audio": {"type": "object", "required": ["mix"], "properties": {"mix": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": true}]}}, "additionalProperties": true}
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "assetId", "footageKey", "fromFrame", "toFrameExclusive", "durationInFrames"],
      "properties": {
        "id": {"type": "string"},
        "assetId": {"type": "string"},
        "footageKey": {"type": "string"},
        "fromFrame": {"type": "integer", "minimum": 0},
        "toFrameExclusive": {"type": "integer", "exclusiveMinimum": 0},
        "durationInFrames": {"type": "integer", "exclusiveMinimum": 0},
        "sourceInSeconds": {"type": "number", "minimum": 0},
        "sourceOutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "playbackRate": {"type": "number", "exclusiveMinimum": 0},
        "playbackMode": {"enum": ["normal", "loop", "hold"]},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/scene"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
