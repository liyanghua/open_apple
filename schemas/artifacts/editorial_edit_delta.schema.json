{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/editorial_edit_delta",
  "title": "Editorial Edit Delta",
  "description": "A typed, replayable edit request against one EditorialTimeline snapshot.",
  "type": "object",
  "required": ["version", "delta_id", "session_id", "base_generation_id", "base_timeline_hash", "operation_sequence", "idempotency_key", "operations"],
  "properties": {
    "version": {"const": "1.0"},
    "delta_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "base_generation_id": {"$ref": "#/$defs/identifier"},
    "base_timeline_hash": {"$ref": "#/$defs/sha256"},
    "operation_sequence": {"type": "integer", "minimum": 1},
    "idempotency_key": {"$ref": "#/$defs/identifier"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "seconds": {"type": "number", "minimum": 0},
    "text_style_token": {"enum": ["taobao_selling_point_v1", "taobao_subtitle_v1", "taobao_cta_v1"]},
    "text_position": {"enum": ["top_center", "center", "bottom_center"]},
    "fact_scope": {
      "type": "object",
      "required": ["claim_ids", "shot_id", "visual_requirement_id", "allowed_source_classes"],
      "properties": {
        "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "shot_id": {"$ref": "#/$defs/identifier"},
        "visual_requirement_id": {"$ref": "#/$defs/identifier"},
        "allowed_source_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["owned_source", "generated_from_product_image", "approved_generated_asset"]}}
      },
      "additionalProperties": false
    },
    "video_clip": {
      "type": "object",
      "required": ["id", "asset_id", "source_sha256", "source_in_seconds", "source_out_seconds", "start_seconds", "fact_scope"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "asset_id": {"$ref": "#/$defs/identifier"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_in_seconds": {"$ref": "#/$defs/seconds"},
        "source_out_seconds": {"type": "number", "exclusiveMinimum": 0},
        "start_seconds": {"$ref": "#/$defs/seconds"},
        "fact_scope": {"$ref": "#/$defs/fact_scope"}
      },
      "additionalProperties": false
    },
    "operation": {
      "oneOf": [
        {"type": "object", "required": ["op", "track_id", "clip"], "properties": {"op": {"const": "add_clip"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip": {"$ref": "#/$defs/video_clip"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id"], "properties": {"op": {"const": "remove_clip"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "start_seconds"], "properties": {"op": {"const": "move_clip"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "start_seconds": {"$ref": "#/$defs/seconds"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "at_seconds"], "properties": {"op": {"const": "split_clip"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "at_seconds": {"$ref": "#/$defs/seconds"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "source_in_seconds", "source_out_seconds"], "properties": {"op": {"const": "trim_clip"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "source_in_seconds": {"$ref": "#/$defs/seconds"}, "source_out_seconds": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "asset_id", "source_sha256", "source_in_seconds", "source_out_seconds"], "properties": {"op": {"const": "replace_clip"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "asset_id": {"$ref": "#/$defs/identifier"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "source_in_seconds": {"$ref": "#/$defs/seconds"}, "source_out_seconds": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "speed"], "properties": {"op": {"const": "set_speed"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "speed": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "transition"], "properties": {"op": {"const": "set_transition"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "transition": {"enum": ["cut", "fade", "crossfade"]}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "start_seconds"], "properties": {"op": {"const": "move_audio"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "start_seconds": {"$ref": "#/$defs/seconds"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "gain_db"], "properties": {"op": {"const": "set_gain"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "gain_db": {"type": "number"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id"], "anyOf": [{"required": ["fade_in_seconds"]}, {"required": ["fade_out_seconds"]}], "properties": {"op": {"const": "set_fade"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "fade_in_seconds": {"$ref": "#/$defs/seconds"}, "fade_out_seconds": {"$ref": "#/$defs/seconds"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "enabled", "reduction_db"], "properties": {"op": {"const": "set_ducking"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "enabled": {"type": "boolean"}, "reduction_db": {"type": "number", "maximum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "asset_id", "source_sha256"], "properties": {"op": {"const": "replace_narration"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "asset_id": {"$ref": "#/$defs/identifier"}, "source_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "asset_id", "source_sha256"], "properties": {"op": {"const": "replace_music"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "asset_id": {"$ref": "#/$defs/identifier"}, "source_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "text"], "properties": {"op": {"const": "set_caption_text"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "text": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "start_seconds", "end_seconds"], "properties": {"op": {"const": "set_caption_timing"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "start_seconds": {"$ref": "#/$defs/seconds"}, "end_seconds": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "style_token", "position"], "properties": {"op": {"const": "set_text_style"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "style_token": {"$ref": "#/$defs/text_style_token"}, "position": {"$ref": "#/$defs/text_position"}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "start_seconds", "end_seconds"], "properties": {"op": {"const": "set_text_timing"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "start_seconds": {"$ref": "#/$defs/seconds"}, "end_seconds": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["op", "track_id", "clip_id", "enabled"], "properties": {"op": {"const": "set_enabled"}, "track_id": {"$ref": "#/$defs/identifier"}, "clip_id": {"$ref": "#/$defs/identifier"}, "enabled": {"type": "boolean"}}, "additionalProperties": false}
      ]
    }
  },
  "additionalProperties": false
}
