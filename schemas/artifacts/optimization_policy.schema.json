{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/optimization_policy",
  "title": "Optimization Policy",
  "description": "Autoresearch 优化策略（Autoresearch_Video_Remix_Integration_Design_2026-08-23.md §3.1）：冻结 rubric、维度权重、通过阈值与循环预算。运行开始后不得修改；enabled=false 的项目保持原 pipeline 行为（人工 review 优先）。",
  "type": "object",
  "required": [
    "version", "project_id", "created_at", "enabled", "score_scale",
    "rubric_version", "per_dimension_min", "weighted_total_min",
    "required_dimensions", "weights", "beam_width", "max_parallel",
    "max_iterations", "max_retries_per_candidate", "confirmation_runs",
    "max_total_cost_usd", "plateau_delta"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "enabled": {
      "type": "boolean",
      "description": "true=启用自动优化循环；false=仅人工 review（默认）"
    },
    "score_scale": { "type": "string", "const": "0-10" },
    "rubric_version": {
      "type": "string",
      "minLength": 1,
      "description": "固定 rubric（ecommerce-remix-v1.0）；与 video_judge 输出的 rubric_version 不一致的报告不可比较"
    },
    "per_dimension_min": { "type": "number", "minimum": 0, "maximum": 10, "description": "任一 required dimension 的最低分（默认 8.0）" },
    "weighted_total_min": { "type": "number", "minimum": 0, "maximum": 10, "description": "加权总分阈值（默认 8.5）" },
    "required_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "必须评分的维度 id；缺失或 skip 即失败"
    },
    "weights": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
      "description": "维度权重，总和必须为 1.0"
    },
    "beam_width": { "type": "integer", "minimum": 1, "maximum": 10, "description": "首轮候选数（默认 5）" },
    "max_parallel": { "type": "integer", "minimum": 1, "maximum": 5, "description": "候选级最大并发（默认 3）" },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 20, "description": "最大迭代轮数（默认 6）" },
    "max_retries_per_candidate": { "type": "integer", "minimum": 0, "description": "每候选技术失败重试上限（默认 2）" },
    "confirmation_runs": { "type": "integer", "minimum": 1, "maximum": 3, "description": "最终候选确认评分次数（默认 2）" },
    "max_total_cost_usd": {
      "type": "number",
      "minimum": 0,
      "description": "0 = 由项目预算（cost_tracker）注入，非无限预算"
    },
    "plateau_delta": { "type": "number", "minimum": 0, "description": "连续两轮总分提升小于该值即停止（默认 0.1）" },
    "semantic_sha256": { "type": "string" },
    "artifact_sha256": { "type": "string" }
  },
  "additionalProperties": false
}
