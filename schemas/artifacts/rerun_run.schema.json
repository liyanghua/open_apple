    "plan": {"type": "object"}, "status": {"enum": ["draft_plan", "preview_running", "awaiting_preview_review", "full_running", "awaiting_final_review", "promoted", "discarded"]},
    "progress": {"type": "object"}, "preview_ref": {}, "output_ref": {}, "current_revision": {"type": "string"}, "created_at": {"type": "string"}, "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
