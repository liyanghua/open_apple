{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/delivery_review",
  "title": "Delivery Review",
  "description": "Operator decisions for producing a new delivery version. Media locations and arbitrary timeline edits are intentionally excluded.",
  "type": "object",
  "required": [
    "schema_version", "project_id", "base_render_id", "base_version_id",
    "selected_cover_id", "selected_hook_id", "selected_bgm_id",
    "selected_ending_id", "copy_overrides", "updated_by", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "base_render_id": {"type": "string", "minLength": 1},
    "base_version_id": {"type": "string", "minLength": 1},
    "selected_cover_id": {"$ref": "#/$defs/cover_id"},
    "selected_hook_id": {"$ref": "#/$defs/hook_id"},
    "selected_bgm_id": {"$ref": "#/$defs/bgm_id"},
    "selected_bgm_volume": {"type": "number", "minimum": 0, "maximum": 1},
    "selected_ending_id": {"$ref": "#/$defs/ending_id"},
    "copy_overrides": {
      "type": "array",
      "items": {"$ref": "#/$defs/copy_override"}
    },
    "updated_by": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "cover_id": {
      "type": ["string", "null"],
      "pattern": "^cover-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "hook_id": {
      "type": ["string", "null"],
      "pattern": "^hook-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "bgm_id": {
      "type": ["string", "null"],
      "pattern": "^bgm-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "ending_id": {
      "type": ["string", "null"],
      "pattern": "^ending-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "copy_override": {
      "type": "object",
      "required": ["segment_id", "text", "sync_narration"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "sync_narration": {"type": "boolean", "default": true}
      },
      "additionalProperties": false
    }
  }
}
