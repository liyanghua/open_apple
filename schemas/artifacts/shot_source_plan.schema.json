{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/shot_source_plan",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "shot_id",
    "revision",
    "sku",
    "parent_budget_id",
    "original_purpose_id",
    "dependencies",
    "requirements",
    "uses",
    "references",
    "lineage_id",
    "global_requirement_ids"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "parent_budget_id": {
      "type": "string",
      "minLength": 1
    },
    "original_purpose_id": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "object",
      "required": [
        "fact_snapshot",
        "category_profile",
        "production_lock"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "required",
          "method",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "method": {
            "enum": [
              "frame_sampling",
              "full_playback",
              "human_observation",
              "probe",
              "decode",
              "audio_listening"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "interval": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "deadline_seconds": {
            "type": "number",
            "minimum": 0
          },
          "min_hold_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "purpose_id",
          "required_requirement_ids"
        ],
        "properties": {
          "purpose_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required_requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "interval": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "additionalProperties": true
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference_id",
          "media_type",
          "roles",
          "purpose",
          "scope",
          "source"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "enum": [
              "image",
              "video",
              "audio"
            ]
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "scope": {},
          "source": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": true
          },
          "authorization_refs": {
            "type": "array",
            "items": {}
          },
          "generation_receipt_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "global_requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Explicit requirements that every original or alternate purpose must satisfy, including declared product identity boundaries. Whole-view coverage may remain original-only."
    }
  },
  "additionalProperties": true
}
