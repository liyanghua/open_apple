{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/reference_fingerprint",
  "title": "Reference Fingerprint",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "content_sha256", "analysis_depth", "analyzer_version", "canonical_request", "output_digest", "abstract_structure"],
  "properties": {
    "version": {"type": "string"}, "project_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "analysis_depth": {"type": "string", "enum": ["transcript_only", "standard", "deep"]}, "analyzer_version": {"type": "string", "minLength": 1},
    "canonical_request": {"type": "object", "additionalProperties": true}, "output_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "abstract_structure": {"type": "object", "additionalProperties": true},
    "shot_patterns": {"type": "array", "items": {"type": "object", "required": ["shot_id", "evidence_refs"], "properties": {"shot_id": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
    "beat_patterns": {"type": "array", "items": {"type": "object", "required": ["beat_id", "mechanism"], "properties": {"beat_id": {"type": "string"}, "mechanism": {"type": "string"}}, "additionalProperties": true}},
    "whole_video": {"type": "object", "required": ["beat_order", "pacing_curve"], "properties": {"beat_order": {"type": "array", "items": {"type": "string"}}, "pacing_curve": {"type": "string"}}, "additionalProperties": true},
    "continuity_contract": {"type": "array", "items": {"$ref": "#/$defs/continuity_anchor"}}
  },
  "$defs": {
    "continuity_anchor": {
      "type": "object",
      "required": ["anchor_id", "category", "scope", "strength", "source", "evidence_refs", "allowed_variation", "conflict_policy"],
      "properties": {
        "anchor_id": {"type": "string"},
        "category": {"enum": ["subject_identity", "brand_claim", "setting_space", "action_physical_state", "time_causality", "shot_visual_grammar", "light_color_material", "narrative_audio_copy"]},
        "scope": {"enum": ["shot", "beat", "whole_video"]}, "strength": {"enum": ["hard", "soft"]},
        "source": {"enum": ["reference_observation", "owned_asset_fact", "brand_rule", "industry_prior", "user_decision"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "allowed_variation": {"type": "string"}, "conflict_policy": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [{
    "if": {"properties": {"version": {"const": "2.0"}}, "required": ["version"]},
    "then": {"required": ["shot_patterns", "beat_patterns", "whole_video", "continuity_contract"]}
  }],
  "additionalProperties": false
}
