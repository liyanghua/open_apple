{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/source_media_review",
  "title": "Source Media Review",
  "description": "Structured review of user-supplied media files. Created before the first planning stage when user media exists. Ensures the agent inspects actual media content instead of planning around assumptions.",
  "type": "object",
  "required": ["version", "files", "summary", "planning_implications"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "caption_policy_version": { "type": "string", "const": "1.0" },
    "files": {
      "type": "array",
      "description": "Reviewed source files. Empty when no user media was supplied (or none could be reviewed) — a valid 'fully generated production' state that review_source_media reports explicitly.",
      "items": {
        "type": "object",
        "required": ["path", "media_type", "reviewed"],
        "properties": {
          "media_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "media_type": {
            "type": "string",
            "enum": ["video", "audio", "image"]
          },
          "reviewed": {
            "type": "boolean",
            "const": true,
            "description": "Must be true — the file was actually inspected, not assumed"
          },
          "technical_probe": {
            "type": "object",
            "description": "Raw ffprobe or metadata output for this file",
            "properties": {
              "duration_seconds": { "type": "number" },
              "resolution": { "type": "string" },
              "fps": { "type": "number" },
              "codec": { "type": "string" },
              "audio_codec": { "type": "string" },
              "sample_rate": { "type": "integer" },
              "channels": { "type": "integer" },
              "file_size_bytes": { "type": "integer" },
              "bitrate_kbps": { "type": "number" }
            }
          },
          "content_summary": {
            "type": "string",
            "description": "What the file actually contains — described from observation, not assumption"
          },
          "transcript_summary": {
            "type": "string",
            "description": "Summary of spoken content, if audio/video with speech"
          },
          "representative_frames": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Paths to sampled frames (video/image only)"
          },
          "scenes": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": true}
          },
          "best_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start_seconds", "end_seconds"],
              "additionalProperties": false,
              "properties": {
                "start_seconds": {"type": "number", "minimum": 0},
                "end_seconds": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          },
          "usable_audio": {"type": "boolean"},
          "transcription_skipped_reason": {"type": "string", "minLength": 1},
          "quality_risks": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Quality issues that affect planning (low resolution, poor audio, shaky footage, etc.)"
          },
          "source_captions": {
            "type": "array",
            "items": {"$ref": "#/$defs/source_caption"}
          },
          "usable_for": {
            "type": "array",
            "items": { "type": "string" },
            "description": "What this file can be used for in the production (hero footage, b-roll, background audio, etc.)"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "summary": {
      "type": "string",
      "description": "What the supplied media actually contains and what it does not. Be specific — 'contains 45s of interview footage, no b-roll, mono audio at 44.1kHz' not 'user provided footage'"
    },
    "planning_implications": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Concrete constraints or opportunities that must affect proposal/script/scene planning. Each item should be actionable.",
      "minItems": 1
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "source_caption": {
      "type": "object",
      "required": ["caption_id", "media_id", "origin", "text", "start_seconds", "end_seconds", "region", "rights", "copy", "claim"],
      "properties": {
        "caption_id": {"type": "string", "minLength": 1},
        "media_id": {"type": "string", "minLength": 1},
        "origin": {"enum": ["owned", "reference"]},
        "text": {"type": "string", "minLength": 1},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "region": {"$ref": "#/$defs/region"},
        "rights": {"$ref": "#/$defs/review"},
        "copy": {"$ref": "#/$defs/review"},
        "claim": {"$ref": "#/$defs/review"}
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object", "required": ["x", "y", "width", "height"], "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 100}, "y": {"type": "number", "minimum": 0, "maximum": 100},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
      }
    },
    "review": {
      "type": "object", "required": ["status"], "additionalProperties": true,
      "properties": {"status": {"enum": ["approved", "pending", "rejected"]}}
    }
  },
  "allOf": [{
    "if": {"required": ["caption_policy_version"]},
    "then": {"properties": {"caption_policy_version": {"const": "1.0"}}}
  }]
}
