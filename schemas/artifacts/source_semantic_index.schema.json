{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/source_semantic_index",
  "title": "Source Semantic Index",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "input_mode", "entries"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_mode": {"enum": ["source_led", "source_led_template"]},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "interval": {"type": "object", "required": ["start_seconds", "end_seconds_exclusive"], "properties": {"start_seconds": {"type": "number", "minimum": 0}, "end_seconds_exclusive": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
    "crop_safety": {"type": "object", "required": ["subject_complete_in_3_4", "safe_caption_regions"], "properties": {"subject_complete_in_3_4": {"type": "boolean"}, "safe_caption_regions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "quality": {"type": "object", "required": ["usable", "confidence", "risks"], "properties": {"usable": {"type": "boolean"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "risks": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "entry": {
      "type": "object",
      "required": ["media_id", "source_path", "source_hash", "interval", "observed_subject", "observed_actions", "observed_results", "evidence_class", "allowed_claim_ids", "crop_safety", "quality", "representative_frames"],
      "properties": {
        "media_id": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "minLength": 1}, "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "interval": {"$ref": "#/$defs/interval"},
        "observed_subject": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observed_results": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_class": {"enum": ["identity", "static_feature", "dynamic_action", "dynamic_result", "measurement", "metaphor_prop"]},
        "measurement_type": {"type": "string", "minLength": 1},
        "temporal_evidence": {
          "type": "object",
          "required": ["before", "action", "result"],
          "properties": {"before": {"$ref": "#/$defs/interval"}, "action": {"$ref": "#/$defs/interval"}, "result": {"$ref": "#/$defs/interval"}},
          "additionalProperties": false
        },
        "allowed_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "crop_safety": {"$ref": "#/$defs/crop_safety"}, "quality": {"$ref": "#/$defs/quality"},
        "representative_frames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"evidence_class": {"const": "measurement"}}, "required": ["evidence_class"]}, "then": {"required": ["measurement_type"]}},
        {"if": {"properties": {"evidence_class": {"not": {"const": "measurement"}}}, "required": ["evidence_class"]}, "then": {"not": {"required": ["measurement_type"]}}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
