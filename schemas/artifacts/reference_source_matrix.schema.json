{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/reference_source_matrix",
  "title": "Reference / Source Evidence Matrix",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "rows", "unmatched_gaps"],
  "properties": {
    "version": {"type": "string"}, "project_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "matrix_mode": {"enum": ["reference", "source_led", "source_led_template"]},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}, "unmatched_gaps": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  },
  "$defs": {
    "interval": {"type": "object", "required": ["start_seconds", "end_seconds_exclusive"], "properties": {"start_seconds": {"type": "number", "minimum": 0}, "end_seconds_exclusive": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
    "row": {
      "type": "object",
      "required": ["matrix_row_id", "reference_scene_id", "reference_time_range", "reference_intent", "source_media_id", "source_time_range", "match_reason", "confidence", "evidence_frames", "unmatched_gap", "resolution"],
      "properties": {
        "matrix_row_id": {"type": "string", "minLength": 1}, "reference_scene_id": {"type": ["string", "null"]}, "reference_time_range": {"oneOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]}, "reference_intent": {"type": "string", "minLength": 1},
        "source_media_id": {"type": ["string", "null"]}, "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_time_range": {"oneOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]}, "match_reason": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_frames": {"type": "array", "items": {"type": "string"}}, "unmatched_gap": {"type": ["string", "null"]}, "resolution": {"enum": ["pending", "accept", "replace_source", "bridge", "rewrite", "omit"]},
        "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "action_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "product_fact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^product_facts\\.claims\\[[0-9]+\\]$"}}, "allowed_wording": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "prohibited_wording": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence_strength": {"enum": ["strong", "moderate", "weak"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"anyOf": [{"not": {"required": ["matrix_mode"]}}, {"required": ["matrix_mode"], "properties": {"matrix_mode": {"const": "reference"}}}]}, "then": {"properties": {"rows": {"items": {"properties": {"reference_scene_id": {"type": "string", "minLength": 1}, "reference_time_range": {"$ref": "#/$defs/interval"}}}}}}},
    {"if": {"required": ["matrix_mode"], "properties": {"matrix_mode": {"enum": ["source_led", "source_led_template"]}}}, "then": {"properties": {"rows": {"items": {"required": ["source_hash", "claim_ids", "action_keys", "product_fact_refs", "allowed_wording", "prohibited_wording", "evidence_strength"], "properties": {"matrix_row_id": {"type": "string", "pattern": "^evidence-[A-Za-z0-9][A-Za-z0-9._-]*$"}, "reference_scene_id": {"type": "null"}, "reference_time_range": {"type": "null"}, "source_media_id": {"type": "string", "minLength": 1}, "source_time_range": {"$ref": "#/$defs/interval"}, "evidence_frames": {"type": "array", "minItems": 1}, "resolution": {"enum": ["accept", "replace_source"]}}}}}}}
  ],
  "additionalProperties": false
}
