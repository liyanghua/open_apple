{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bound opening experiment observation",
  "type": "object",
  "required": ["version", "import_id", "result_version", "experiment_ref", "candidate_id", "record_ref", "render_ref", "platform", "account_id", "publication_id", "ad_id", "audience", "window", "metrics", "fee", "raw_export_ref", "sample"],
  "properties": {
    "version": {"const": "1.0"},
    "import_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "result_version": {"type": "integer", "minimum": 1},
    "experiment_ref": {"$ref": "#/$defs/file_ref"},
    "candidate_id": {"type": "string", "minLength": 1},
    "record_ref": {"allOf": [{"$ref": "#/$defs/file_ref"}, {"type": "object", "required": ["version"], "properties": {"version": {"type": "string", "minLength": 1}}}]},
    "render_ref": {"$ref": "#/$defs/file_ref"},
    "platform": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "minLength": 1},
    "publication_id": {"type": ["string", "null"]},
    "ad_id": {"type": ["string", "null"]},
    "audience": {"type": "object", "required": ["description", "allocation_id", "allocation_method"], "properties": {
      "description": {"type": "string", "minLength": 1},
      "allocation_id": {"type": ["string", "null"]},
      "allocation_method": {"type": "string", "minLength": 1}
    }, "additionalProperties": false},
    "window": {"type": "object", "required": ["start", "end", "timezone", "semantics", "label"], "properties": {
      "start": {"type": "string", "format": "date-time"},
      "end": {"type": "string", "format": "date-time"},
      "timezone": {"type": "string", "minLength": 1},
      "semantics": {"enum": ["cumulative", "disjoint"]},
      "label": {"type": "string", "minLength": 1}
    }, "additionalProperties": false},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["metric_id", "definition", "kind", "numerator", "numerator_unit", "denominator", "denominator_unit", "count_unit", "duration_unit", "support_count"], "properties": {
      "metric_id": {"type": "string", "minLength": 1},
      "definition": {"type": "string", "minLength": 1},
      "kind": {"enum": ["rate", "count", "duration"]},
      "numerator": {"type": ["number", "null"], "minimum": 0},
      "numerator_unit": {"type": "string", "minLength": 1},
      "denominator": {"type": ["number", "null"], "minimum": 0},
      "denominator_unit": {"type": "string", "minLength": 1},
      "count_unit": {"type": "string", "minLength": 1},
      "duration_unit": {"type": ["string", "null"], "enum": ["seconds", "milliseconds", null]},
      "support_count": {"type": ["integer", "null"], "minimum": 0}
    }, "additionalProperties": false}},
    "fee": {"type": "object", "required": ["amount", "currency", "settlement_status"], "properties": {
      "amount": {"type": ["number", "null"], "minimum": 0},
      "currency": {"type": ["string", "null"]},
      "settlement_status": {"enum": ["unknown", "estimated", "settled"]}
    }, "additionalProperties": false},
    "raw_export_ref": {"$ref": "#/$defs/file_ref"},
    "sample": {"type": "object", "required": ["conditions", "limitations"], "properties": {
      "conditions": {"type": "string", "minLength": 1},
      "limitations": {"type": "string", "minLength": 1}
    }, "additionalProperties": false},
    "imported_at": {"type": "string", "format": "date-time"},
    "imported_by": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "file_ref": {"type": "object", "required": ["path", "sha256"], "properties": {
      "path": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "version": {"type": "string", "minLength": 1},
      "seconds": {"type": "number", "exclusiveMinimum": 0}
    }, "additionalProperties": false}
  },
  "additionalProperties": false
}
