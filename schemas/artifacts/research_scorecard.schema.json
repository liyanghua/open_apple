{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/research_scorecard",
  "title": "Research Scorecard",
  "type": "object",
  "required": ["version", "project_id", "created_at", "producer", "input_hashes", "semantic_sha256", "artifact_sha256", "score", "max_score", "status", "checks", "hard_failures", "warnings"],
  "properties": {
    "version": {"type": "string"}, "project_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "score": {"type": "number", "minimum": 0}, "max_score": {"type": "number", "exclusiveMinimum": 0}, "status": {"enum": ["pass", "review", "fail"]}, "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}, "hard_failures": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"check": {"type": "object", "required": ["id", "label", "score", "status", "message"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "score": {"type": "number", "minimum": 0}, "status": {"enum": ["pass", "review", "fail"]}, "message": {"type": "string"}}, "additionalProperties": false}},
  "additionalProperties": false
}
