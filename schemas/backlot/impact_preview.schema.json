{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmontage.local/schemas/backlot/impact_preview.schema.json",
  "title": "ImpactPreview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "valid", "summary", "changed_fields", "affected_stages", "affected_scene_ids", "render_mode", "reopen_reviews", "estimated_seconds", "estimate_confidence", "estimated_cost_usd", "warnings", "preview_token", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "draft_id": {"type": "string", "minLength": 1},
    "valid": {"type": "boolean"},
    "summary": {"type": "string"},
    "changed_fields": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "affected_stages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "affected_scene_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "render_mode": {"enum": ["无需重新生成视频", "保留画面，仅更新声音", "重新生成完整画面"]},
    "reopen_reviews": {"type": "array", "items": {"enum": ["creative_lock", "sample"]}, "uniqueItems": true},
    "estimated_seconds": {"type": ["integer", "null"], "minimum": 0},
    "estimate_confidence": {"enum": ["low", "medium", "high", null]},
    "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "preview_token": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "label", "before", "after"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "before": {"type": ["string", "number", "boolean", "null"]},
        "after": {"type": ["string", "number", "boolean", "null"]}
      }
    }
  }
}
