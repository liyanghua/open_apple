{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmontage.local/schemas/backlot/operator_review.schema.json",
  "title": "OperatorReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "project_id", "kind", "subject_id", "subject_version", "subject_hash", "status", "submitted_by", "decided_by", "reason", "created_at", "decided_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["creative_lock", "sample"]},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_version": {"type": "integer", "minimum": 1},
    "subject_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "status": {"enum": ["awaiting_human", "approved", "rejected", "superseded"]},
    "submitted_by": {"type": "string", "minLength": 1},
    "decided_by": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "decided_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
