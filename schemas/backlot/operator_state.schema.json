{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/backlot/operator_state",
  "title": "Backlot Operator Project State",
  "type": "object",
  "required": [
    "schema_version", "project_id", "title", "pipeline", "skill", "summary",
    "stages", "workspace", "pending_review", "permissions", "active_job",
    "revision", "legacy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "pipeline": {"type": "string", "minLength": 1},
    "skill": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "summary": {"$ref": "#/$defs/summary"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    },
    "workspace": {"$ref": "#/$defs/workspace"},
    "pending_review": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/pending_review"}
      ]
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["view", "edit", "review", "manage"]}
    },
    "active_job": {"type": "null"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "legacy": {"$ref": "#/$defs/legacy"}
  },
  "additionalProperties": false,
  "$defs": {
    "nullable_string": {"type": ["string", "null"]},
    "nullable_number": {"type": ["number", "null"], "minimum": 0},
    "summary": {
      "type": "object",
      "required": [
        "current_stage", "current_task", "progress_percent", "next_action",
        "estimated_seconds", "estimate_confidence", "spent_usd"
      ],
      "properties": {
        "current_stage": {"type": "string", "minLength": 1},
        "current_task": {"type": "string", "minLength": 1},
        "progress_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "next_action": {"type": "string", "minLength": 1},
        "estimated_seconds": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
        },
        "estimate_confidence": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["low", "medium", "high"]}
          ]
        },
        "spent_usd": {"$ref": "#/$defs/nullable_number"},
        "performance": {
          "type": "object",
          "required": ["promise", "message"],
          "properties": {
            "promise": {"$ref": "#/$defs/nullable_string"},
            "message": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": [
        "id", "label", "status", "version", "updated_at", "updated_by",
        "editable", "summary", "warnings", "editor"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["未开始", "制作中", "等待确认", "已完成", "处理失败", "状态未知"]
        },
        "version": {"type": "integer", "minimum": 0},
        "updated_at": {"$ref": "#/$defs/nullable_string"},
        "updated_by": {"$ref": "#/$defs/nullable_string"},
        "editable": {"type": "boolean"},
        "summary": {"type": "string"},
        "warnings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "editor": {"$ref": "#/$defs/editor"}
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": ["stage_id", "editor", "read_only", "upgrade_action"],
      "properties": {
        "stage_id": {"type": "string", "minLength": 1},
        "editor": {"$ref": "#/$defs/editor"},
        "read_only": {"const": true},
        "upgrade_action": {"$ref": "#/$defs/nullable_string"}
      },
      "additionalProperties": false
    },
    "pending_review": {
      "type": "object",
      "required": ["kind", "label", "summary", "subject_version"],
      "properties": {
        "kind": {"enum": ["creative_lock", "sample", "stage"]},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "subject_version": {"type": "integer", "minimum": 0},
        "review_id": {"type": "string", "minLength": 1},
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["批准", "拒绝"]}
        }
      },
      "additionalProperties": false
    },
    "legacy": {
      "type": "object",
      "required": ["read_only", "source_pipeline", "upgrade_available", "message"],
      "properties": {
        "read_only": {"type": "boolean"},
        "source_pipeline": {"type": "string", "minLength": 1},
        "upgrade_available": {"type": "boolean"},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    },
    "editor": {
      "oneOf": [
        {"$ref": "#/$defs/research_editor"},
        {"$ref": "#/$defs/proposal_editor"},
        {"$ref": "#/$defs/script_editor"},
        {"$ref": "#/$defs/shot_editor"},
        {"$ref": "#/$defs/asset_editor"},
        {"$ref": "#/$defs/sample_editor"},
        {"$ref": "#/$defs/edit_editor"},
        {"$ref": "#/$defs/delivery_editor"},
        {"$ref": "#/$defs/unavailable_editor"}
      ]
    },
    "research_editor": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "research_review"},
        "data": {
          "type": "object",
          "required": ["reference_summary", "source_count", "usable_count", "risks", "sources", "reference"],
          "properties": {
            "reference_summary": {"type": "string"},
            "source_count": {"type": "integer", "minimum": 0},
            "usable_count": {"type": "integer", "minimum": 0},
            "risks": {"type": "array", "items": {"type": "string"}},
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id", "label", "media_type", "summary", "reviewed", "usable_for", "risks",
                  "duration_seconds", "resolution", "fps", "best_in_seconds", "best_out_seconds",
                  "preview_url", "poster_url"
                ],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "label": {"type": "string"},
                  "media_type": {"type": "string"},
                  "summary": {"type": "string"},
                  "reviewed": {"type": "boolean"},
                  "usable_for": {"type": "array", "items": {"type": "string"}},
                  "risks": {"type": "array", "items": {"type": "string"}},
                  "duration_seconds": {"$ref": "#/$defs/nullable_number"},
                  "resolution": {"type": "string"},
                  "fps": {"$ref": "#/$defs/nullable_number"},
                  "best_in_seconds": {"$ref": "#/$defs/nullable_number"},
                  "best_out_seconds": {"$ref": "#/$defs/nullable_number"},
                  "preview_url": {"$ref": "#/$defs/nullable_string"},
                  "poster_url": {"$ref": "#/$defs/nullable_string"}
                },
                "additionalProperties": false
              }
            },
            "reference": {
              "type": "object",
              "required": [
                "title", "summary", "duration_seconds", "hook", "beat_order", "proof_method",
                "avg_evidence_seconds", "camera_method", "caption_method", "typography", "transitions",
                "replicate", "differentiate", "preview_url", "poster_url", "scenes"
              ],
              "properties": {
                "title": {"type": "string"},
                "summary": {"type": "string"},
                "duration_seconds": {"$ref": "#/$defs/nullable_number"},
                "hook": {"type": "string"},
                "beat_order": {"type": "array", "items": {"type": "string"}},
                "proof_method": {"type": "string"},
                "avg_evidence_seconds": {"$ref": "#/$defs/nullable_number"},
                "camera_method": {"type": "string"},
                "caption_method": {"type": "string"},
                "typography": {"type": "string"},
                "transitions": {"type": "array", "items": {"type": "string"}},
                "replicate": {"type": "array", "items": {"type": "string"}},
                "differentiate": {"type": "array", "items": {"type": "string"}},
                "preview_url": {"$ref": "#/$defs/nullable_string"},
                "poster_url": {"$ref": "#/$defs/nullable_string"},
                "scenes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "description", "screen_copy", "energy", "start_seconds", "end_seconds", "poster_url"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "description": {"type": "string"},
                      "screen_copy": {"type": "string"},
                      "energy": {"type": "string"},
                      "start_seconds": {"type": "number", "minimum": 0},
                      "end_seconds": {"type": "number", "minimum": 0},
                      "poster_url": {"$ref": "#/$defs/nullable_string"}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "proposal_editor": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "proposal_choice"},
        "data": {
          "type": "object",
          "required": ["concepts", "selected_id", "estimated_cost_usd"],
          "properties": {
            "concepts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id", "title", "hook", "duration_seconds", "core_message", "target_audience",
                  "tone", "visual_approach", "why_this_works", "key_points", "cta",
                  "narrative_structure", "target_platform"
                ],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "title": {"type": "string"},
                  "hook": {"type": "string"},
                  "duration_seconds": {"$ref": "#/$defs/nullable_number"},
                  "core_message": {"type": "string"},
                  "target_audience": {"type": "string"},
                  "tone": {"type": "string"},
                  "visual_approach": {"type": "string"},
                  "why_this_works": {"type": "string"},
                  "key_points": {"type": "array", "items": {"type": "string"}},
                  "cta": {"type": "string"},
                  "narrative_structure": {"type": "string"},
                  "target_platform": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "selected_id": {"$ref": "#/$defs/nullable_string"},
            "estimated_cost_usd": {"$ref": "#/$defs/nullable_number"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "timed_section": {
      "type": "object",
      "required": ["id", "label", "text", "start_seconds", "end_seconds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "text": {"type": "string"},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "script_editor": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "script_editor"},
        "data": {
          "type": "object",
          "required": ["duration_seconds", "sections"],
          "properties": {
            "duration_seconds": {"$ref": "#/$defs/nullable_number"},
            "sections": {"type": "array", "items": {"$ref": "#/$defs/timed_section"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "required": [
        "id", "beat", "screen_copy", "source_label", "in_seconds", "out_seconds",
        "timeline_in_seconds", "timeline_out_seconds", "source_in_seconds", "source_out_seconds",
        "preview_url", "poster_url", "intent", "framing", "movement", "narrative_role",
        "source_summary", "source_usable_for", "mapping_reason", "reference_evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "beat": {"type": "string"},
        "screen_copy": {"type": "string"},
        "source_label": {"type": "string"},
        "in_seconds": {"type": "number", "minimum": 0},
        "out_seconds": {"type": "number", "minimum": 0},
        "timeline_in_seconds": {"type": "number", "minimum": 0},
        "timeline_out_seconds": {"type": "number", "minimum": 0},
        "source_in_seconds": {"$ref": "#/$defs/nullable_number"},
        "source_out_seconds": {"$ref": "#/$defs/nullable_number"},
        "preview_url": {"$ref": "#/$defs/nullable_string"},
        "poster_url": {"$ref": "#/$defs/nullable_string"},
        "intent": {"type": "string"},
        "framing": {"type": "string"},
        "movement": {"type": "string"},
        "narrative_role": {"type": "string"},
        "source_summary": {"type": "string"},
        "source_usable_for": {"type": "array", "items": {"type": "string"}},
        "mapping_reason": {"type": "string"},
        "reference_evidence": {"$ref": "#/$defs/reference_evidence"}
      },
      "additionalProperties": false
    },
    "reference_evidence": {
      "type": "object",
      "required": [
        "mode", "reference_scene_id", "description", "mechanism", "rationale",
        "start_seconds", "end_seconds", "preview_url", "poster_url"
      ],
      "properties": {
        "mode": {"enum": ["direct_segment", "structural_only", "none"]},
        "reference_scene_id": {"type": "string"},
        "description": {"type": "string"},
        "mechanism": {"type": "string"},
        "rationale": {"type": "string"},
        "start_seconds": {"$ref": "#/$defs/nullable_number"},
        "end_seconds": {"$ref": "#/$defs/nullable_number"},
        "preview_url": {"$ref": "#/$defs/nullable_string"},
        "poster_url": {"$ref": "#/$defs/nullable_string"}
      },
      "additionalProperties": false
    },
    "shot_editor": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "shot_mapping"},
        "data": {
          "type": "object",
          "required": ["duration_seconds", "reference_basis", "shots"],
          "properties": {
            "duration_seconds": {"$ref": "#/$defs/nullable_number"},
            "reference_basis": {
              "type": "object",
              "required": ["summary", "beat_order", "proof_method", "avg_evidence_seconds"],
              "properties": {
                "summary": {"type": "string"},
                "beat_order": {"type": "array", "items": {"type": "string"}},
                "proof_method": {"type": "string"},
                "avg_evidence_seconds": {"$ref": "#/$defs/nullable_number"}
              },
              "additionalProperties": false
            },
            "shots": {"type": "array", "items": {"$ref": "#/$defs/shot"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "asset_editor": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "asset_review"},
        "data": {
          "type": "object",
          "required": [
            "narration_status", "subtitle_status", "music_status", "estimated_cost_usd"
          ],
          "properties": {
            "narration_status": {"type": "string"},
            "subtitle_status": {"type": "string"},
            "music_status": {"type": "string"},
            "estimated_cost_usd": {"$ref": "#/$defs/nullable_number"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sample_editor": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "sample_review"},
        "data": {
          "type": "object",
          "required": ["duration_seconds", "preview_url", "qa_status", "review_summary"],
          "properties": {
            "duration_seconds": {"$ref": "#/$defs/nullable_number"},
            "preview_url": {"$ref": "#/$defs/nullable_string"},
            "qa_status": {"type": "string"},
            "review_summary": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "edit_editor": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "edit_review"},
        "data": {
          "type": "object",
          "required": ["change_scope", "reasons", "affected_shot_count"],
          "properties": {
            "change_scope": {"type": "string"},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "affected_shot_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "delivery_editor": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "delivery_review"},
        "data": {
          "type": "object",
          "required": ["duration_seconds", "qa_status", "download_url", "format_label"],
          "properties": {
            "duration_seconds": {"$ref": "#/$defs/nullable_number"},
            "qa_status": {"type": "string"},
            "download_url": {"$ref": "#/$defs/nullable_string"},
            "format_label": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "unavailable_editor": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "unavailable"},
        "data": {
          "type": "object",
          "required": ["message"],
          "properties": {"message": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
